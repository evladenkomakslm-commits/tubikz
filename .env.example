# --- БД (Postgres) ---
# Локально: docker-compose up -d или Neon URL
# Production (Render): pooled Neon URL — host содержит "-pooler"
DATABASE_URL="postgresql://user:pass@localhost:5432/tubikz"
# Direct (non-pooled) Neon URL — нужен только для prisma migrate.
# В Neon Dashboard выключи "Pooled connection" и скопируй (host без "-pooler").
DIRECT_URL="postgresql://user:pass@localhost:5432/tubikz"

# --- Auth (NextAuth) ---
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# --- Storage (UploadThing) ---
# Если не задан — uploads сохраняются локально в public/uploads (только dev)
UPLOADTHING_TOKEN=""

# --- Web Push (VAPID) ---
# Сгенерить: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# --- Calls / TURN (Cloudflare Realtime) ---
# Бесплатно 1 ТБ/мес. Cloudflare Dashboard → Realtime → TURN → создать ключ.
# Без них звонки работают только в пределах одной сети (нет NAT-relay).
CLOUDFLARE_TURN_TOKEN_ID=""
CLOUDFLARE_TURN_API_TOKEN=""

# --- AI (опционально, иначе анонимный Pollinations) ---
# console.groq.com → API Keys. Llama 3.3 70B, бесплатно 30 req/min.
GROQ_API_KEY=""

# --- Server ---
PORT=3000
